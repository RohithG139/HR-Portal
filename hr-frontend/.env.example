# CubeWorks HR Frontend — environment variables
# Copy this file to .env and fill in the values for your local setup.

# Base URL of the Spring Boot backend REST API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080/api

# Keycloak (CLAUDE.md §1.3). None of these are secrets — hr-frontend is a public
# OIDC client (no client secret), so it's safe for Vite to inline them into the
# built JS. A production deploy must still override all three to https origins.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=cubeworks-hr
VITE_KEYCLOAK_CLIENT_ID=hr-frontend
